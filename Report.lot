\contentsline {table}{\numberline {5.4}{\ignorespaces Benchmark overall performance results for Llama 3.3 vs FUNES grouped by task difficulty. The scores are computed by aggregating the points obtained across all evaluation criteria applicable to the questions belonging to each difficulty category, their details are in Tables \ref {tab: easy_question_results}, \ref {tab: medium_question_results}, and \ref {tab: hard_question_results}.}}{79}{table.caption.70}%
\contentsline {table}{\numberline {5.5}{\ignorespaces Benchmark scores for easy questions, each metric has a maximum score of 2 points. The total score is computed by aggregating the points obtained across all evaluation criteria applicable to the question. \textbf {Legenda}: AC = Answer Correctness, AI = Anomaly Identification, EC = Evidence Correlation, NF = Noise Filtering, DSS = DSS Role Adherence, ORQ = Operational Recommendation Quality.}}{80}{table.caption.71}%
\contentsline {table}{\numberline {5.6}{\ignorespaces Benchmark scores for medium questions, each metric has a maximum score of 2 points. The total score is computed by aggregating the points obtained across all evaluation criteria applicable to the question. \textbf {Legenda}: AC = Answer Correctness, AI = Anomaly Identification, EC = Evidence Correlation, NF = Noise Filtering, DSS = DSS Role Adherence, ORQ = Operational Recommendation Quality.}}{81}{table.caption.72}%
\contentsline {table}{\numberline {5.7}{\ignorespaces Benchmark scores for hard questions, each metric has a maximum score of 2 points. The total score is computed by aggregating the points obtained across all evaluation criteria applicable to the question. \textbf {Legenda}: AC = Answer Correctness, AI = Anomaly Identification, EC = Evidence Correlation, NF = Noise Filtering, DSS = DSS Role Adherence, ORQ = Operational Recommendation Quality.}}{81}{table.caption.73}%
