\@writefile{toc}{\contentsline {paragraph}{Document Chunking}{44}{section*.34}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Document chunking workflow implemented in the Storage Manager. The document is preprocessed for metadata extraction like: "chunk\_id", "content\_hash", "source", "title", "author", "last\_modified", "page\_number", "chunk\_index\_in\_page", "chunk\_size" and "format". Then the repetitive parrterns like page headers and footers are removed. The text is then cleaned and transformed into markdown. Finally the chunking process will turn the text into vectors that are going to be associated with the metadata and the original text.}}{46}{figure.caption.35}\protected@file@percent }
\newlabel{fig:chunking_pipeline}{{4.1}{46}{Document chunking workflow implemented in the Storage Manager. The document is preprocessed for metadata extraction like: "chunk\_id", "content\_hash", "source", "title", "author", "last\_modified", "page\_number", "chunk\_index\_in\_page", "chunk\_size" and "format". Then the repetitive parrterns like page headers and footers are removed. The text is then cleaned and transformed into markdown. Finally the chunking process will turn the text into vectors that are going to be associated with the metadata and the original text}{figure.caption.35}{}}
\@writefile{toc}{\contentsline {paragraph}{Embedding Generation}{46}{section*.36}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Vector Storage}{46}{section*.37}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Knowledge Memory Management}{47}{section*.38}\protected@file@percent }
\citation{cormack2009reciprocal}
\citation{cormack2009reciprocal}
\newlabel{eq:rrf}{{4.2}{48}{Knowledge Memory Management}{equation.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces \textbf  {Architecture of the Hybrid RAG System.} The system integrates a \textit  {Storage Pipeline} (top) that cleans, dynamically chunks, and deduplicates raw documents using SHA-1 hashing, indexing unique content simultaneously into a dense vector database (\texttt  {ChromaDB}) and a sparse lexical in-memory index (\texttt  {BM25Okapi}, serialized via \texttt  {pickle}); and a \textit  {Retrieval Pipeline} (bottom) that executes parallel dense-semantic and sparse-keyword searches for a given query, merges the candidate results using Reciprocal Rank Fusion (RRF) based on a unified \texttt  {chunk\_id}, and re-ranks them using a Cross-Encoder model (\texttt  {BAAI/bge-reranker-base}) to output the top-$k$ most contextually relevant passages for the downstream LLM.}}{49}{figure.caption.39}\protected@file@percent }
\newlabel{fig:rag_architecture}{{4.2}{49}{\textbf {Architecture of the Hybrid RAG System.} The system integrates a \textit {Storage Pipeline} (top) that cleans, dynamically chunks, and deduplicates raw documents using SHA-1 hashing, indexing unique content simultaneously into a dense vector database (\texttt {ChromaDB}) and a sparse lexical in-memory index (\texttt {BM25Okapi}, serialized via \texttt {pickle}); and a \textit {Retrieval Pipeline} (bottom) that executes parallel dense-semantic and sparse-keyword searches for a given query, merges the candidate results using Reciprocal Rank Fusion (RRF) based on a unified \texttt {chunk\_id}, and re-ranks them using a Cross-Encoder model (\texttt {BAAI/bge-reranker-base}) to output the top-$k$ most contextually relevant passages for the downstream LLM}{figure.caption.39}{}}
\@writefile{toc}{\contentsline {paragraph}{RAG Validation}{49}{section*.40}\protected@file@percent }
